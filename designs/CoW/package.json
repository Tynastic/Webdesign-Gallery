{
  "name": "war-room",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "description": "War Room – collaborative strategy map for Call of War: Supremacy 1942",
  "scripts": {
    "dev": "concurrently -k -n web,sync -c yellow,cyan \"vite\" \"npm:server:dev\"",
    "server:dev": "node --no-warnings=ExperimentalWarning --watch server/index.ts",
    "start": "node --no-warnings=ExperimentalWarning server/index.ts",
    "build": "vue-tsc --noEmit && vite build && node scripts/compress-dist.ts",
    "preview": "npm run build && npm start",
    "backup": "node --no-warnings=ExperimentalWarning scripts/backup.ts",
    "map:build": "node scripts/build-map-data.ts",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@hocuspocus/extension-database": "^4.7.0",
    "@hocuspocus/server": "^4.7.0",
    "nanoid": "^6.0.2",
    "yjs": "^13.6.33"
  },
  "devDependencies": {
    "@hocuspocus/provider": "^4.7.0",
    "@playwright/test": "^1.63.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.4",
    "@vitejs/plugin-vue": "^6.0.9",
    "concurrently": "^10.0.5",
    "fast-xml-parser": "^5.11.2",
    "fuse.js": "^7.5.0",
    "html-to-image": "^1.11.13",
    "leaflet": "^1.9.4",
    "lucide-vue-next": "^1.0.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9",
    "vite": "^8.3.3",
    "vitest": "^5.0.3",
    "vue": "^3.5.43",
    "vue-tsc": "^3.3.12",
    "y-indexeddb": "^9.0.12",
    "y-protocols": "^1.0.7"
  },
  "engines": {
    "node": ">=22.18"
  }
}
