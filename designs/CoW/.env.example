# Copy to .env and fill in. Used by docker-compose.yml.

# Public domain; its DNS A/AAAA record must point to this server (Caddy gets the HTTPS certificate).
DOMAIN=warroom.example.org

# Secret for the admin read-outs (/api/admin/feedback, /errors, /stats). Generate with: openssl rand -base64 32
ADMIN_TOKEN=

# Optional
# APP_COMMIT=          # shown as version suffix; set with: export APP_COMMIT=$(git rev-parse --short HEAD)
# ROOM_TTL_DAYS=90     # delete rooms after this many days without changes
# LIMIT_ROOMS_PER_HOUR=10
# LIMIT_CONNECTIONS_PER_IP=20

# Cloudflare Tunnel (docker-compose.tunnel.yml): leave empty for a quick tunnel; DOMAIN is not used then.
# TUNNEL_TOKEN=
# TUNNEL_ARGS=tunnel --no-autoupdate run

# Optional closed beta login (also uncomment basic_auth in Caddyfile)
# BETA_USER=tester
# BETA_PASSWORD_HASH=
